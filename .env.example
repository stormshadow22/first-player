# Copy to .env. Python and Compose read it; shell environment takes precedence.
# Never commit .env or credentials.
LLM_MOCK=1
LLM_PROVIDER=openai_compatible
# Verified 2026-10-31: https://developers.openai.com/api/docs/models/gpt-5.6-luna
LLM_MODEL=gpt-5.6-luna
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# Conservative input upper bound, including a 1.25x cache-write multiplier.
# Standard input is $0.20/MTok; output is $1.20/MTok. Recheck before live use.
LLM_PRICE_IN_PER_MTOK=0.25
LLM_PRICE_OUT_PER_MTOK=1.20
LLM_TOKEN_LIMIT_FIELD=max_completion_tokens
LLM_REASONING_EFFORT=none
LLM_PROMPT_CACHE=0
DEDUP_ENABLED=0
